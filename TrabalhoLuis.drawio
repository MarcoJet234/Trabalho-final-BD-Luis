        <mxCell id="1" parent="0"/>
        <mxCell id="LEG" value="&lt;b&gt;LEGENDA&lt;/b&gt;&lt;br&gt;&lt;br&gt;INT, VARCHAR, TEXT, DATE, DATETIME, DECIMAL, BOOLEAN etc.: tipos dos campos.&lt;br&gt;&lt;br&gt;PK = chave primária.&lt;br&gt;FK = chave estrangeira.&lt;br&gt;UK = campo único.&lt;br&gt;&lt;br&gt;As linhas cinza representam os relacionamentos entre as tabelas. Os conectores foram roteados por corredores livres para não atravessar outras tabelas." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=24;fontSize=22;fontColor=#29263a;fillColor=#effcf8;strokeColor=#18c9b4;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="1500" height="600" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
